# ==============================================================================
# PUMO TECHNOVATION EXAM PORTAL - POONAMALLEE
# Production & Local Environment Configuration Template
# Developed By: Team SAT
# ==============================================================================

# Core Django Security
# Generate a strong 50+ character random key for production
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret-key-pumo-2026
DEBUG=False

# Allowed domain names & IP addresses (comma-separated)
# e.g.: exam.pumotechnovation.com,192.168.1.100,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,*.yourdomain.com

# CSRF Trusted Origins (required for POST forms when running behind HTTPS or custom domain)
# e.g.: https://exam.pumotechnovation.com,http://localhost:8000
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (MySQL 8.0 recommended)
DB_ENGINE=django.db.backends.mysql
DB_NAME=pumo_exam_portal
DB_USER=pumo_admin
DB_PASSWORD=your_strong_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# OCR / External Execution Services (Optional)
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_api_key

# Email Configuration (Sends student login credentials upon account creation)
# Leave EMAIL_HOST_USER blank to print emails to console for local testing.
# For production Gmail SMTP: Enable 2-Step Verification and generate an App Password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_organization@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=SATX Exam Portal <your_organization@gmail.com>
